// Updated schema for booking enhancements
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TENANT
  GUEST
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
}

enum BookingStatus {
  PENDING
  ACTIVE
  ENDED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PAID
  UNPAID
}

enum ComplaintStatus {
  NEW
  IN_PROGRESS
  DONE
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  password         String
  role             Role      @default(GUEST)
  phone            String?
  ktpNumber        String?
  ktpPhoto         String?
  emergencyContact String?
  createdAt        DateTime  @default(now())

  bookings         RoomBooking[]
  complaints       Complaint[]
  announcements    Announcement[]
}

model Room {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  size        String?
  floor       String?
  photos      String[]
  facilities  String[]
  status      RoomStatus @default(AVAILABLE)
  createdAt   DateTime @default(now())

  bookings    RoomBooking[]
  complaints  Complaint[]
}

model RoomBooking {
  id        String   @id @default(uuid())
  userId    String
  roomId    String
  startDate DateTime
  endDate   DateTime
  status    BookingStatus @default(PENDING)
  duration  Int      @default(1)
  paymentMethod String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  room      Room     @relation(fields: [roomId], references: [id])
  payments  Payment[]
}

model Payment {
  id        String   @id @default(uuid())
  bookingId String
  amount    Float
  month     Int
  year      Int
  status    PaymentStatus @default(UNPAID)
  paidAt    DateTime?
  note      String?
  proofPhoto String?
  paymentMethod String?
  createdAt DateTime @default(now())

  booking   RoomBooking @relation(fields: [bookingId], references: [id])
}

model Complaint {
  id          String   @id @default(uuid())
  userId      String
  roomId      String
  title       String
  description String
  status      ComplaintStatus @default(NEW)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  room        Room     @relation(fields: [roomId], references: [id])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  adminId   String
  createdAt DateTime @default(now())

  admin     User     @relation(fields: [adminId], references: [id])
}
